# python:3.14-slim (tag conservado como comentario; Dependabot actualiza el digest)
FROM python:3.14-slim@sha256:656d12e70054d5fda18a045e2494c96701e9792dd1445f95b3d038df954f57e9

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Ejecutar como usuario sin privilegios (auditoría 2026-08-02, CIS Docker):
# el ETL escribe en /app/data; el usuario tiene escritura ahí abajo.
RUN useradd --create-home --uid 1000 observatorio \
    && mkdir -p /app/data && chown -R observatorio:observatorio /app
USER observatorio

CMD ["python", "-m", "etl.run_all"]
