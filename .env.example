# Variables de entorno para desarrollo local (sección 13: secretos nunca en el repo)
# Copiar a .env y ajustar. POSTGRES_PASSWORD solo de desarrollo: usar una
# contraseña fuerte en staging/producción.
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio_dev
DATABASE_URL=postgresql://observatorio:observatorio_dev@localhost:5432/observatorio
API_PORT=8000

# Fuentes piloto (ver docs/fuentes/*.md para el método de acceso verificado)
# DANE: solo Excel oficial (la rama legacy Socrata se eliminó en auditoría
# 2026-08-02: no existe dataset nacional con el shape esperado)
DANE_POBLACION_XLSX_URL=
DANE_POBLACION_HOJA=
VICTIMAS_URL=
PDET_URL=

# DIVIPOLA (opcional; defaults oficiales en datos.gov.co)
DIVIPOLA_DEPT_DATASET=vcjz-niiq
DIVIPOLA_MUN_DATASET=gdxc-w37w
