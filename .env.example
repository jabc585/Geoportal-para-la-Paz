# Variables de entorno para desarrollo local (sección 13: secretos nunca en el repo)
# Copiar a .env y ajustar. POSTGRES_PASSWORD solo de desarrollo: usar una
# contraseña fuerte en staging/producción.
# La carga de este archivo es automática: etl/common/config.py (pydantic-settings)
# se importa desde la clase base PipelineETL, así que cualquier pipeline, run_all
# o la API leen .env sin exportar nada en el shell.

# ─── Infraestructura ───
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio_dev
DATABASE_URL=postgresql://observatorio:observatorio_dev@localhost:5432/observatorio
API_PORT=8000

# ─── Fuentes nacionales ───
# DANE: solo Excel oficial (la rama legacy Socrata se eliminó en auditoría
# 2026-08-02: no existe dataset nacional con el shape esperado). URL verificada
# en vivo 2026-08-02 (proyecciones municipales 2020-2035 post COVID-19).
DANE_POBLACION_XLSX_URL=https://www.dane.gov.co/files/censo2018/proyecciones-de-poblacion/Municipal/DCD-area-proypoblacion-Mun-2020-2035-ActPostCOVID-19.xlsx
DANE_POBLACION_HOJA=
# Unidad de Víctimas (Datos Paz): sin default por diseño (ver docs/fuentes/victimas.md)
VICTIMAS_URL=
# ART/PDET: dataset Socrata de iniciativas PDET (ver docs/fuentes/art.md).
# URL verificada en vivo 2026-08-02 (33.007 iniciativas, 16 PDET).
PDET_URL=https://www.datos.gov.co/resource/gmvf-t63e.json
# CNMH (memoria histórica): datasets SIEVCAC reales, uno por tipo de hecho
CNMH_MINAS_URL=https://www.datos.gov.co/resource/52eu-ic7d.json
CNMH_ATENTADOS_URL=https://www.datos.gov.co/resource/yfd7-8c9d.json
CNMH_DESAPARICION_URL=https://www.datos.gov.co/resource/c59y-p4sz.json
CNMH_RECLUTAMIENTO_URL=https://www.datos.gov.co/resource/hzd2-7ea7.json
CNMH_BIENES_URL=https://www.datos.gov.co/resource/a2ga-ur2i.json
CNMH_ACCIONES_URL=https://www.datos.gov.co/resource/chb6-bfmq.json
# Fiscalía: datasets Socrata V3 (pipeline listo; NO activo en run_all por
# volumen: la agregación SoQL reescanea 23M filas y tarda ~10 min por página,
# ver docs/fuentes/fiscalia.md)
FISCALIA_PROCESOS_URL=
FISCALIA_VICTIMAS_URL=
# Policía: datasets Socrata por tipo de delito (homicidios pendiente de localizar)
POLICIA_HURTO_URL=
POLICIA_VIOLENCIA_URL=
POLICIA_SEXUALES_URL=
POLICIA_HOMICIDIOS_URL=

# DIVIPOLA (opcional; defaults oficiales en datos.gov.co)
DIVIPOLA_DEPT_DATASET=vcjz-niiq
DIVIPOLA_MUN_DATASET=gdxc-w37w

# ─── Fuentes internacionales ───
# Banco Mundial: lista "codigo:nombre" separada por comas
WB_INDICADORES=NY.GDP.PCAP.PP.CD:PIB per cápita (PPA)
# UNHCR/ACNUR: API pública sin autenticación
UNHCR_BASE_URL=https://api.unhcr.org/population/v1
# HDX: API CKAN pública (HAPI de Colombia: hdx-hapi-col)
HDX_BASE_URL=https://data.humdata.org/api/3
HDX_CONFLICTO_RESOURCE_ID=bbdfa1bf-0dd3-4235-b20c-1bd6c0de365e


ACLED_KEY=
# Socrata App Token (opcional, eleva el límite de tasa)
SOCRATA_APP_TOKEN=
